APP_NAME=steel-market-agent
ENVIRONMENT=dev
LOG_LEVEL=INFO

# PostgreSQL：Agent 读写账号 / MCP 只读账号
DATABASE_URL_AGENT=postgresql+asyncpg://steel_agent:CHANGE_ME@localhost:5432/steel_market
DATABASE_URL_MCP=postgresql+asyncpg://steel_mcp:CHANGE_ME@localhost:5432/steel_market

# docker-compose 初始化使用
AGENT_DB_PASSWORD=CHANGE_ME
MCP_DB_PASSWORD=CHANGE_ME

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=CHANGE_ME
MCP_BASE_URL=http://localhost:8001
MCP_SERVICE_SECRET=CHANGE_ME
CHROMA_PATH=../data/chroma
HF_ENDPOINT=https://hf-mirror.com

# 会话与限流
SESSION_IDLE_MINUTES=60
DATA_RATE_LIMIT=120
IMPORT_RATE_LIMIT=5

# LLM 成本控制
LLM_DAILY_REQUEST_LIMIT=200
LLM_MAX_ATTEMPTS_PER_PROVIDER=1
LLM_MAX_TOTAL_ATTEMPTS=3

# 生产部署（docker-compose.prod.yml）；生产时把 CORS_ORIGINS 改为 https 域名
APP_DOMAIN=steel.example.com
AGENT_WORKERS=2
# 仅本地生产模拟时允许 localhost 来源
PROD_ALLOW_LOCAL_ORIGINS=0

# 备份加密（生产必填；至少 32 位）
BACKUP_PASSPHRASE=CHANGE_ME
BACKUP_KEEP_DAYS=30

LLM_FALLBACK_ORDER=claude,deepseek,doubao
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

CORS_ORIGINS=["http://localhost:5173"]
